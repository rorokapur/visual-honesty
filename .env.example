# --- PRODUCTION CONFIGURATION ---
# These variables are REQUIRED for production deployment (npm start).
# Local development (npm run dev) is handled by docker-compose.override.yml automatically.

# IMPORTANT: Change this to a 32+ character random string for production
SESSION_SECRET=paste_a_long_random_production_secret_here_so_it_works

# Database credentials for the production container
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=visual_honesty