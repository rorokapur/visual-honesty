{
  "name": "visual-honesty-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"docker compose up -d\" \"npm run client:dev\"",
    "client:dev": "cd client && npm run dev",
    "app:logs": "docker compose logs -f app",
    "start": "docker compose -f docker-compose.yml up --build",
    "stop": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  }
}
